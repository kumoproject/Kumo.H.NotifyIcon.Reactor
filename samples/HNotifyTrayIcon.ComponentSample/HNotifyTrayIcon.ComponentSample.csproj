<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>ARM64;x64;AnyCPU</Platforms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Unpackaged self-contained + Native AOT: `dotnet publish -c Release
         -p:Platform=ARM64` produces the AOT win-arm64 exe. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- WindowsAppSDKSelfContained needs a concrete Windows architecture even when
       the solution is built with the AnyCPU default (e.g. `dotnet build` on the
       .slnx). Pick the RID from the requested platform, else from the host CPU. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PROCESSOR_ARCHITECTURE)' == 'AMD64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (not a sidecar file): the tray icon is built from raw bytes via
         HNotifyWindowIcon.FromBytes — the preview15 WindowIcon.FromBytes stand-in. -->
    <EmbeddedResource Include="app.ico" LogicalName="HNotifyTrayIcon.ComponentSample.app.ico" />
    <ProjectReference Include="..\..\src\Kumo.H.NotifyIcon.Reactor\Kumo.H.NotifyIcon.Reactor.csproj" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.14" />
  </ItemGroup>

  <!-- WindowsAppSDK #6394 (open against 1.8/2.0): the NativeAOT publish pipeline
       does not copy an unpackaged app's own $(AssemblyName).pri (nor .xbf files)
       into the publish directory — MRT/XAML resource lookups then fail at
       runtime with stowed exceptions in Microsoft.UI.Xaml.dll. Workaround copied
       from microsoft-ui-reactor's Reactor.AppTests.Host.csproj (commit 458f30b);
       remove once the upstream issue is fixed. -->
  <Target Name="CopyXamlResourcesForAot" AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_XamlResources Include="$(OutputPath)**\*.xbf" />
      <_XamlResources Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlResources)"
          DestinationFiles="@(_XamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
